+      o << ",\"blocker_p\":";vector(f.obstacle_position);
+      o << ",\"los_blocker_p\":";vector(f.los_obstacle_position);
+      o << ",\"los_effective_radius\":";number(f.los_obstacle_effective_radius);
+      o << ",\"los_primitive_type\":" << f.los_primitive_type
