+    // Read-only blocker-relative telemetry.  The production frame is shared
+    // by the LOS observation plane; when it is unavailable, reconstruct the
+    // same right normal from blocker - target.  This records the geometry of
+    // seeds and optimizer outputs without influencing candidate admission.
+    const auto log_topology_oracle = [&](const char *phase,
+                                         const CandidateResult &candidate,
+                                         const poly_traj::Trajectory &trajectory,
+                                         const double trajectory_start,
+                                         const int hard_safe,
+                                         const double first_binary_recovery,
+                                         const double persistent_recovery) {
+      const auto &conflict = candidate.conflict;
+      if ((conflict.reason_mask & CONFLICT_LOS_OCCLUSION) == 0 ||
+          conflict.los_obstacle_identity < 0 ||
