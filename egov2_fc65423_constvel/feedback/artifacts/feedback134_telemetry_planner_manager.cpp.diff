+        const Eigen::Vector2d forward =
+            blocker_at_event.head<2>() - conflict.target_position.head<2>();
+        if (forward.norm() <= 1.0e-6)
+          return;
+        const Eigen::Vector2d e = forward.normalized();
+        right = Eigen::Vector3d(e.y(), -e.x(), 0.0);
+      }
+      right.z() = 0.0;
+      right.normalize();
+      const double event_time = std::max(
+          0.0, std::min(duration, std::isfinite(conflict.los_conflict_time)
+                                     ? conflict.los_conflict_time : 0.0));
+      const double scan_begin = std::max(0.0, event_time - 0.5);
+      const double scan_end = std::min(duration, event_time + 1.5);
+      const double sample_dt = 0.05;
+      const double effective_radius =
+          std::isfinite(conflict.radius) ? std::max(0.0, conflict.radius) : 0.0;
+      double min_shadow_clearance = std::numeric_limits<double>::infinity();
+      double min_axis_offset = std::numeric_limits<double>::infinity();
+      double event_signed_side = 0.0;
+      double shadow_exit_time = -1.0;
+      int side_crossings = 0;
+      int previous_sign = 0;
+      bool entered_shadow = false;
+      bool found_shadow_exit = false;
+      for (double raw_t = scan_begin;; raw_t += sample_dt)
+      {
+        const double t = std::min(raw_t, scan_end);
+        Eigen::Vector3d blocker = conflict.los_obstacle_position;
+        if (conflict.los_obstacle_motion == ConflictObstacleMotion::DYNAMIC &&
+            obj_predictor_ && obj_predictor_->hasPrediction(
+                                  conflict.los_obstacle_identity))
+          blocker = obj_predictor_->evaluateConstVel(
+              conflict.los_obstacle_identity, trajectory_start + t);
+        const double signed_side = right.dot(trajectory.getPos(t) - blocker);
+        if (std::abs(t - event_time) <= sample_dt * 0.51)
+          event_signed_side = signed_side;
+        const double axis_offset = std::abs(signed_side);
+        min_axis_offset = std::min(min_axis_offset, axis_offset);
+        min_shadow_clearance = std::min(
+            min_shadow_clearance, axis_offset - effective_radius);
+        const int sign = signed_side > 1.0e-4 ? 1
+                         : signed_side < -1.0e-4 ? -1 : 0;
+        if (sign != 0)
+        {
+          if (previous_sign != 0 && sign != previous_sign)
+            ++side_crossings;
+          previous_sign = sign;
+        }
