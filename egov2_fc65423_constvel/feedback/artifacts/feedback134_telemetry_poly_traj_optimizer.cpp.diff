+    // Opt-in payload snapshots around the existing LOS refinement. The
+    // destructor also records early returns; it never validates or changes it.
+    struct LosPayloadAudit134 {
+      const poly_traj::MinJerkOpt &optimizer;
+      int drone;
+      std::string kind;
+      double epoch;
+      const char *directory;
+      LosPayloadAudit134(const poly_traj::MinJerkOpt &value, int id,
+                         const std::string &candidate_kind, double start)
+          : optimizer(value), drone(id), kind(candidate_kind), epoch(start),
+            directory(std::getenv("ALP_TOPOLOGY_AUDIT_DIR")) { dump("PRE_LOS"); }
+      ~LosPayloadAudit134() { dump("POST_LOS"); }
+      void dump(const char *stage) const {
+        if (!directory || !*directory) return;
+        static std::ofstream output(std::string(directory) + "/los_drone_" +
+            std::to_string(drone) + ".jsonl", std::ios::app);
+        if (!output) return;
+        const auto trajectory=optimizer.getTraj();
+        std::ostringstream o; o << std::setprecision(17);
+        const auto number=[&](double x) {if(std::isfinite(x)) o<<x;else o<<"null";};
+        o << "{\"stage\":" << std::quoted(stage) << ",\"drone\":" << drone
+          << ",\"kind\":" << std::quoted(kind) << ",\"world\":";
+        number(ros::Time::now().toSec());o<<",\"activation\":";number(epoch);
+        o<<",\"pieces\":[";
+        for(int i=0;i<trajectory.getPieceNum();++i) {
+          if(i) o<<',';
+          o<<'[';number(trajectory[i].getDuration());
+          const auto &a=trajectory[i].getCoeffMat();
+          for(int row=0;row<3;++row) for(int col=0;col<6;++col) {o<<',';number(a(row,col));}
+          o<<']';
+        }
+        o<<"]}\n";output<<o.str();
+      }
+    };
