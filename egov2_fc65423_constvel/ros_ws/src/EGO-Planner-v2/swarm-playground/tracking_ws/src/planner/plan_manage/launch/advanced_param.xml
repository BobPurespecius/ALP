<launch>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>
    <arg name="map_size_z_"/>
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="max_vel"/>
    <arg name="max_acc"/>
    <arg name="max_jer"/>
    <arg name="planning_horizon"/>
    <arg name="point_num"/>
    <arg name="point0_x"/>
    <arg name="point0_y"/>
    <arg name="point0_z"/>
    <arg name="point1_x"/>
    <arg name="point1_y"/>
    <arg name="point1_z"/>
    <arg name="point2_x"/>
    <arg name="point2_y"/>
    <arg name="point2_z"/>
    <arg name="point3_x"/>
    <arg name="point3_y"/>
    <arg name="point3_z"/>
    <arg name="point4_x"/>
    <arg name="point4_y"/>
    <arg name="point4_z"/>
    <arg name="relative_tracking_x"/>
    <arg name="relative_tracking_y"/>
    <arg name="relative_tracking_z"/>
    <arg name="enable_cooperative_viewpoint_reference" default="false"/>
    <arg name="cooperative_viewpoint_reference_timeout" default="0.5"/>
    <arg name="use_fov_tracking" default="false"/>
    <arg name="use_fov_costs" default="$(arg use_fov_tracking)"/>
    <arg name="fov_min_target_distance" default="0.7"/>
    <arg name="fov_max_target_distance" default="3.0"/>
    <arg name="fov_lookahead_time" default="1.0"/>
    <arg name="fov_lock_tracking_height" default="true"/>
    <arg name="fov_enable_candidate_goal" default="false"/>
    <arg name="fov_enable_visible_safe_region" default="true"/>
    <arg name="fov_enable_goal_safe_projection" default="false"/>
    <arg name="fov_candidate_count" default="33"/>
    <arg name="fov_frontend_max_waypoints" default="4"/>
    <arg name="fov_candidate_angle_span_deg" default="220.0"/>
    <arg name="fov_tracking_distance" default="1.2"/>
    <arg name="fov_use_los_check" default="true"/>
    <arg name="fov_use_angle_check" default="true"/>
    <arg name="fov_weight" default="8.0"/>
    <arg name="fov_distance_weight" default="0.0"/>
    <arg name="fov_height_weight" default="0.0"/>
    <arg name="fov_occlusion_weight" default="20.0"/>
    <arg name="fov_los_sample_step" default="0.12"/>
    <arg name="fov_half_angle_deg" default="42.5"/>
    <arg name="fov_target_height" default="1.2"/>
    <arg name="fov_angular_weight" default="0.0"/>
    <arg name="fov_angular_min_angle_deg" default="30.0"/>
    <arg name="fov_yaw_weight" default="0.0"/>
    <arg name="fov_yaw_speed_min" default="0.15"/>
    <arg name="fov_safe_region_clearance" default="0.20"/>
    <arg name="fov_frontend_grid_step" default="0.2"/>
    <arg name="fov_frontend_search_margin" default="2.0"/>
    <arg name="fov_frontend_path_weight" default="0.3"/>
    <arg name="fov_enable_soft_retry" default="true"/>
    <arg name="fov_soft_retry_scale" default="1.0"/>
    <arg name="fov_retry_distance_scale" default="1.25"/>
    <arg name="object_velocity_deadband" default="0.5"/>
    <arg name="tracking_error_replan_threshold" default="0.5"/>
    <arg name="tracking_velocity_error_replan_threshold" default="0.5"/>
    <arg name="directional_visibility_deep_risk_kappa" default="1.0"/>
    <arg name="directional_visibility_deep_risk_beta" default="2.0"/>
    <arg name="swarm_clearance" default="0.5"/>
    <arg name="flight_type"/>
    <arg name="use_distinctive_trajs"/>
    <arg name="realworld_experiment" default="false"/>
    <arg name="sequential_start" default="true"/>
    <arg name="preset_start_delay_step" default="0.0"/>
    <arg name="obj_num_set"/>
    <arg name="use_time_aware_moving_obj_cost" default="false"/>
    <arg name="moving_obj_clearance" default="1.1"/>
    <!-- Horizontal collision footprint of the deployed iris model.  This is
         intentionally separate from grid-map occupancy inflation. -->
    <arg name="dynamic_hard_body_radius" default="0.384"/>
    <arg name="moving_obj_lambda" default="0.5"/>
    <arg name="moving_obj_prediction_horizon" default="2.0"/>
    <arg name="moving_obj_time_decay_tau" default="1.8"/>
    <arg name="moving_obj_max_grad" default="3.0"/>
    <arg name="candidate_preserve_weight" default="2.0"/>
    <arg name="enable_candidate_region_constraint" default="true"/>
    <arg name="candidate_region_weight" default="2.0"/>
    <arg name="candidate_region_type" default="quadratic"/>
    <arg name="enable_risk_triggered_candidates" default="false"/>
    <arg name="risk_sample_dt" default="0.10"/>
    <arg name="candidate_trigger_margin" default="0.15"/>
    <arg name="team_visibility_preferred_separation_deg" default="25.0"/>
    <arg name="encirclement_spread_saturation_angle_deg" default="60.0"/>
    <arg name="encirclement_base_angular_slack_deg" default="20.0"/>
    <arg name="enable_encirclement_tracking" default="false"/>
    <arg name="temporal_swarm_trigger_margin" default="0.08"/>
    <arg name="temporal_swarm_sample_dt" default="0.05"/>
    <arg name="temporal_swarm_conflict_half_window" default="0.60"/>
    <arg name="temporal_swarm_time_trust_ratio" default="0.15"/>
    <arg name="temporal_swarm_guard_margin" default="0.01"/>
    <arg name="temporal_swarm_owner_hold_sec" default="0.50"/>
    <arg name="enable_joint_topology_coordination" default="false"/>
    <arg name="topology_coordination_timeout" default="0.20"/>
    <arg name="team_coordination_timeout" default="0.35"/>
    <arg name="topology_result_max_age" default="0.30"/>
    <arg name="topology_min_active_remaining" default="0.35"/>
    <arg name="enable_team_visibility_optimizer" default="false"/>
    <arg name="team_solution_max_age" default="0.30"/>
    <arg name="team_solution_min_activation_lead" default="0.015"/>
    <arg name="team_min_execution_time" default="0.12"/>
    <arg name="visibility_sample_dt" default="0.10"/>
    <arg name="visibility_min_target_distance" default="0.20"/>
    <arg name="visibility_max_target_distance" default="8.0"/>
    <arg name="visibility_occlusion_margin" default="0.08"/>
    <arg name="k3_local_escalation_enabled" default="false"/>
    <arg name="weight_visibility" default="20.0"/>
    <!-- 2026-09-22 恢复:P/T 联合 hard SCP(默认关闭,核心语义回归) -->
    <arg name="enable_candidate_hard_corridor_scp" default="false"/>
    <arg name="candidate_hard_corridor_scp_radius" default="0.5"/>
    <arg name="candidate_hard_corridor_scp_trust_region" default="0.25"/>
    <arg name="candidate_hard_corridor_scp_time_trust_region" default="0.15"/>
    <arg name="candidate_hard_corridor_scp_max_iterations" default="8"/>
    <arg name="candidate_hard_corridor_scp_samples" default="25"/>
    <!-- Extra Team P/T SCP is a separate production refinement.  The old
         candidate hard-corridor policy remains OFF. -->
    <arg name="enable_team_spatiotemporal_scp" default="true"/>
    <arg name="team_scp_p_trust" default="0.30"/>
    <arg name="team_scp_t_trust_ratio" default="0.15"/>
    <arg name="team_scp_max_iterations" default="6"/>
    <arg name="team_scp_soft_weight" default="10.0"/>
    <arg name="team_scp_t_gain_ratio" default="0.80"/>
    <arg name="static_los_scene_file" default=""/>
    <arg name="virtual_ceil_height" default="-1.0"/>
    <arg name="obstacles_inflation" default="0.099"/>
    <arg name="obstacle_clearance" default="0.1"/>
    <arg name="obstacle_clearance_soft" default="0.5"/>
    <arg name="drone_id"/>
    <arg name="broadcast_traj_send_topic" default="/broadcast_traj_from_planner"/>
    <arg name="broadcast_traj_recv_topic" default="/broadcast_traj_to_planner"/>
    <arg name="planner_launch_prefix" default=""/>
    <arg name="planner_required" default="false"/>
    <!-- main node -->
    <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen"
          launch-prefix="$(arg planner_launch_prefix)" required="$(arg planner_required)">
        <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~object" to="/object_odom"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/broadcast_traj_send" to = "$(arg broadcast_traj_send_topic)"/>
        <remap from="~planning/broadcast_traj_recv" to = "$(arg broadcast_traj_recv_topic)"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <!-- <remap from="/goal" to = "/goal_brig2plner"/> -->
        <!-- <remap from="/goal" to = "/goal_with_id"/> -->
        <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/>
        <remap from="~grid_map/cloud" to="/drone_$(arg drone_id)_$(arg cloud_topic)"/>
        <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>
        <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>
        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
        <param name="fsm/thresh_replan_time" value="1.0" type="double"/>
        <param name="fsm/thresh_no_replan_meter" value="1.0" type="double"/>
        <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <!--always set to 1.5 times grater than sensing horizen-->
        <param name="fsm/emergency_time" value="1.0" type="double"/>
        <param name="fsm/realworld_experiment" value="$(arg realworld_experiment)" type="bool"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/sequential_start" value="$(arg sequential_start)" type="bool"/>
        <param name="fsm/preset_start_delay_step" value="$(arg preset_start_delay_step)" type="double"/>
        <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
        <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
        <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
        <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
        <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
        <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
        <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
        <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
        <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
        <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
        <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
        <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
        <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
        <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
        <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
        <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>
        <param name="fsm/relative_tracking_x" value="$(arg relative_tracking_x)"/>
        <param name="fsm/relative_tracking_y" value="$(arg relative_tracking_y)"/>
        <param name="fsm/relative_tracking_z" value="$(arg relative_tracking_z)"/>
        <param name="fsm/enable_cooperative_viewpoint_reference" value="$(arg enable_cooperative_viewpoint_reference)" type="bool"/>
        <param name="fsm/cooperative_viewpoint_reference_timeout" value="$(arg cooperative_viewpoint_reference_timeout)" type="double"/>
        <param name="fsm/use_fov_tracking" value="$(arg use_fov_tracking)" type="bool"/>
        <param name="fsm/fov_lock_tracking_height" value="$(arg fov_lock_tracking_height)" type="bool"/>
        <param name="fsm/fov_enable_candidate_goal" value="$(arg fov_enable_candidate_goal)" type="bool"/>
        <param name="fsm/fov_enable_visible_safe_region" value="$(arg fov_enable_visible_safe_region)" type="bool"/>
        <param name="fsm/fov_enable_goal_safe_projection" value="$(arg fov_enable_goal_safe_projection)" type="bool"/>
        <param name="fsm/fov_min_target_distance" value="$(arg fov_min_target_distance)" type="double"/>
        <param name="fsm/fov_max_target_distance" value="$(arg fov_max_target_distance)" type="double"/>
        <param name="fsm/fov_candidate_count" value="$(arg fov_candidate_count)" type="int"/>
        <param name="fsm/fov_frontend_max_waypoints" value="$(arg fov_frontend_max_waypoints)" type="int"/>
        <param name="fsm/fov_candidate_angle_span_deg" value="$(arg fov_candidate_angle_span_deg)" type="double"/>
        <param name="fsm/fov_tracking_distance" value="$(arg fov_tracking_distance)" type="double"/>
        <param name="fsm/fov_use_los_check" value="$(arg fov_use_los_check)" type="bool"/>
        <param name="fsm/fov_use_angle_check" value="$(arg fov_use_angle_check)" type="bool"/>
        <param name="fsm/fov_lookahead_time" value="$(arg fov_lookahead_time)" type="double"/>
        <param name="fsm/fov_half_angle_deg" value="$(arg fov_half_angle_deg)" type="double"/>
        <param name="fsm/fov_weight" value="$(arg fov_weight)" type="double"/>
        <param name="fsm/fov_occlusion_weight" value="$(arg fov_occlusion_weight)" type="double"/>
        <param name="fsm/fov_los_sample_step" value="$(arg fov_los_sample_step)" type="double"/>
        <param name="fsm/fov_target_height" value="$(arg fov_target_height)" type="double"/>
        <param name="fsm/fov_safe_region_clearance" value="$(arg fov_safe_region_clearance)" type="double"/>
        <param name="fsm/fov_frontend_grid_step" value="$(arg fov_frontend_grid_step)" type="double"/>
        <param name="fsm/fov_frontend_search_margin" value="$(arg fov_frontend_search_margin)" type="double"/>
        <param name="fsm/fov_frontend_path_weight" value="$(arg fov_frontend_path_weight)" type="double"/>
        <param name="fsm/fov_enable_soft_retry" value="$(arg fov_enable_soft_retry)" type="bool"/>
        <param name="fsm/fov_soft_retry_scale" value="$(arg fov_soft_retry_scale)" type="double"/>
        <param name="fsm/fov_retry_distance_scale" value="$(arg fov_retry_distance_scale)" type="double"/>
        <param name="fsm/object_velocity_deadband" value="$(arg object_velocity_deadband)" type="double"/>
        <param name="fsm/tracking_error_replan_threshold" value="$(arg tracking_error_replan_threshold)" type="double"/>
        <param name="fsm/tracking_velocity_error_replan_threshold" value="$(arg tracking_velocity_error_replan_threshold)" type="double"/>
        <param name="grid_map/resolution"      value="0.1" />
        <param name="grid_map/map_size_x"   value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y"   value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z"   value="$(arg map_size_z_)" />
        <param name="grid_map/local_update_range_x"  value="5.5" />
        <param name="grid_map/local_update_range_y"  value="5.5" />
        <param name="grid_map/local_update_range_z"  value="4.5" />
        <param name="grid_map/obstacles_inflation"     value="$(arg obstacles_inflation)" />
        <param name="manager/dynamic_hard_body_radius" value="$(arg dynamic_hard_body_radius)" type="double"/>
        <param name="grid_map/local_map_margin" value="10"/>
        <param name="grid_map/ground_height"        value="-0.01"/>
        <!-- camera parameter -->
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <!-- depth filter -->
        <param name="grid_map/use_depth_filter" value="true"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15"/>
        <param name="grid_map/depth_filter_maxdist"   value="5.0"/>
        <param name="grid_map/depth_filter_mindist"   value="0.2"/>
        <param name="grid_map/depth_filter_margin"    value="2"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="grid_map/p_hit"  value="0.65"/>
        <param name="grid_map/p_miss" value="0.35"/>
        <param name="grid_map/p_min"  value="0.12"/>
        <param name="grid_map/p_max"  value="0.90"/>
        <param name="grid_map/p_occ"  value="0.80"/>
        <param name="grid_map/fading_time"  value="5.0"/>
        <param name="grid_map/min_ray_length" value="0.1"/>
        <param name="grid_map/max_ray_length" value="4.5"/>
        <param name="grid_map/virtual_ceil_height"   value="$(arg virtual_ceil_height)"/>
        <param name="grid_map/visualization_truncate_height"   value="1.9"/>
        <param name="grid_map/show_occ_time"  value="false"/>
        <param name="grid_map/pose_type"     value="1"/>
        <param name="grid_map/frame_id"      value="world"/>
        <!-- planner manager -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/max_jer" value="$(arg max_jer)" type="double"/>
        <param name="manager/polyTraj_piece_length" value="1.5" type="double"/>
        <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
        <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <param name="manager/use_distinctive_trajs" value="$(arg use_distinctive_trajs)" type="bool"/>
        <param name="manager/enable_risk_triggered_candidates" value="$(arg enable_risk_triggered_candidates)" type="bool"/>
        <param name="manager/enable_candidate_region_constraint" value="$(arg enable_candidate_region_constraint)" type="bool"/>
        <param name="manager/risk_sample_dt" value="$(arg risk_sample_dt)" type="double"/>
        <param name="manager/candidate_trigger_margin" value="$(arg candidate_trigger_margin)" type="double"/>
        <param name="manager/team_visibility_preferred_separation_deg" value="$(arg team_visibility_preferred_separation_deg)" type="double"/>
        <param name="manager/encirclement_spread_saturation_angle_deg" value="$(arg encirclement_spread_saturation_angle_deg)" type="double"/>
        <param name="manager/temporal_swarm_trigger_margin" value="$(arg temporal_swarm_trigger_margin)" type="double"/>
        <param name="manager/temporal_swarm_sample_dt" value="$(arg temporal_swarm_sample_dt)" type="double"/>
        <param name="manager/temporal_swarm_conflict_half_window" value="$(arg temporal_swarm_conflict_half_window)" type="double"/>
        <param name="manager/temporal_swarm_time_trust_ratio" value="$(arg temporal_swarm_time_trust_ratio)" type="double"/>
        <param name="manager/temporal_swarm_guard_margin" value="$(arg temporal_swarm_guard_margin)" type="double"/>
        <param name="manager/temporal_swarm_owner_hold_sec" value="$(arg temporal_swarm_owner_hold_sec)" type="double"/>
        <param name="manager/enable_joint_topology_coordination" value="$(arg enable_joint_topology_coordination)" type="bool"/>
        <param name="manager/topology_coordination_timeout" value="$(arg topology_coordination_timeout)" type="double"/>
        <param name="manager/team_coordination_timeout" value="$(arg team_coordination_timeout)" type="double"/>
        <param name="manager/topology_result_max_age" value="$(arg topology_result_max_age)" type="double"/>
        <param name="manager/topology_min_active_remaining" value="$(arg topology_min_active_remaining)" type="double"/>
        <param name="manager/enable_team_visibility_optimizer" value="$(arg enable_team_visibility_optimizer)" type="bool"/>
        <param name="manager/team_solution_max_age" value="$(arg team_solution_max_age)" type="double"/>
        <param name="manager/team_solution_min_activation_lead" value="$(arg team_solution_min_activation_lead)" type="double"/>
        <param name="manager/team_min_execution_time" value="$(arg team_min_execution_time)" type="double"/>
        <param name="manager/visibility_sample_dt" value="$(arg visibility_sample_dt)" type="double"/>
        <param name="manager/visibility_min_target_distance" value="$(arg visibility_min_target_distance)" type="double"/>
        <param name="manager/visibility_max_target_distance" value="$(arg visibility_max_target_distance)" type="double"/>
        <param name="manager/visibility_occlusion_margin" value="$(arg visibility_occlusion_margin)" type="double"/>
        <param name="manager/k3_local_escalation_enabled" value="$(arg k3_local_escalation_enabled)" type="bool"/>
        <param name="manager/drone_id" value="$(arg drone_id)"/>
        <!-- trajectory optimization -->
        <param name="optimization/constraint_points_perPiece" value="5" type="int"/>
        <param name="optimization/weight_obstacle" value="10000.0" type="double"/>
        <param name="optimization/weight_obstacle_soft" value="5000.0" type="double"/>
        <param name="optimization/weight_swarm" value="10000.0" type="double"/>
        <param name="optimization/weight_tracking" value="100.0" type="double"/>
        <param name="optimization/encirclement_base_angular_slack_deg" value="$(arg encirclement_base_angular_slack_deg)" type="double"/>
        <param name="optimization/enable_encirclement_tracking" value="$(arg enable_encirclement_tracking)" type="bool"/>
        <param name="optimization/directional_visibility_deep_risk_kappa" value="$(arg directional_visibility_deep_risk_kappa)" type="double"/>
        <param name="optimization/directional_visibility_deep_risk_beta" value="$(arg directional_visibility_deep_risk_beta)" type="double"/>
        <param name="optimization/use_fov_tracking" value="$(arg use_fov_costs)" type="bool"/>
        <param name="optimization/weight_visibility" value="$(arg weight_visibility)" type="double"/>
        <param name="optimization/enable_candidate_hard_corridor_scp" value="$(arg enable_candidate_hard_corridor_scp)" type="bool"/>
        <param name="optimization/candidate_hard_corridor_scp_radius" value="$(arg candidate_hard_corridor_scp_radius)" type="double"/>
        <param name="optimization/candidate_hard_corridor_scp_trust_region" value="$(arg candidate_hard_corridor_scp_trust_region)" type="double"/>
        <param name="optimization/candidate_hard_corridor_scp_time_trust_region" value="$(arg candidate_hard_corridor_scp_time_trust_region)" type="double"/>
        <param name="optimization/candidate_hard_corridor_scp_max_iterations" value="$(arg candidate_hard_corridor_scp_max_iterations)" type="int"/>
        <param name="optimization/candidate_hard_corridor_scp_samples" value="$(arg candidate_hard_corridor_scp_samples)" type="int"/>
        <param name="optimization/enable_team_spatiotemporal_scp" value="$(arg enable_team_spatiotemporal_scp)" type="bool"/>
        <param name="optimization/team_scp_p_trust" value="$(arg team_scp_p_trust)" type="double"/>
        <param name="optimization/team_scp_t_trust_ratio" value="$(arg team_scp_t_trust_ratio)" type="double"/>
        <param name="optimization/team_scp_max_iterations" value="$(arg team_scp_max_iterations)" type="int"/>
        <param name="optimization/team_scp_soft_weight" value="$(arg team_scp_soft_weight)" type="double"/>
        <param name="optimization/team_scp_t_gain_ratio" value="$(arg team_scp_t_gain_ratio)" type="double"/>
        <param name="optimization/static_los_margin" value="$(arg visibility_occlusion_margin)" type="double"/>
