    <arg name="point3_y" value="$(eval arg('goal1_y') if int(arg('point_num')) == 4 else arg('route_point3_y'))"/>
    <arg name="point3_z" value="$(eval arg('goal1_z') if int(arg('point_num')) == 4 else arg('route_point3_z'))"/>
    <arg name="point4_x" value="$(arg goal1_x)"/>
    <arg name="point4_y" value="$(arg goal1_y)"/>
    <arg name="point4_z" value="$(arg goal1_z)"/>
    <arg name="relative_tracking_x" value="0.0"/>
    <arg name="relative_tracking_y" value="0.0"/>
    <arg name="relative_tracking_z" value="0.0"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
