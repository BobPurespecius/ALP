    <arg name="odometry_topic" value="visual_slam/odom"/>
    <arg name="obj_num_set" value="$(arg moving_obj_num)"/>
    <arg name="use_time_aware_moving_obj_cost" value="$(arg use_time_aware_moving_obj_cost)"/>
    <arg name="moving_obj_clearance" value="$(arg moving_obj_clearance)"/>
    <arg name="moving_obj_lambda" value="$(arg moving_obj_lambda)"/>
    <arg name="moving_obj_prediction_horizon" value="$(arg moving_obj_prediction_horizon)"/>
    <arg name="moving_obj_time_decay_tau" value="$(arg moving_obj_time_decay_tau)"/>
    <arg name="moving_obj_max_grad" value="$(arg moving_obj_max_grad)"/>
    <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
    <arg name="depth_topic" value="pcl_render_node/depth"/>
    <arg name="cloud_topic" value="pcl_render_node/cloud"/>
    <arg name="cx" value="321.04638671875"/>
    <arg name="cy" value="243.44969177246094"/>
    <arg name="fx" value="387.229248046875"/>
    <arg name="fy" value="387.229248046875"/>
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="$(arg max_acc)"/>
    <arg name="max_jer" value="$(arg max_jer)"/>
    <arg name="planning_horizon" value="$(arg planning_horizon)"/>
    <arg name="use_distinctive_trajs" value="true"/>
    <arg name="realworld_experiment" value="true"/>
    <arg name="sequential_start" value="true"/>
    <arg name="flight_type" value="2"/>
    <arg name="preset_start_delay_step" value="$(arg preset_start_delay_step)"/>
    <arg name="point_num" value="$(arg point_num)"/>
    <arg name="point0_x" value="$(eval arg('goal4_x') if int(arg('point_num')) == 1 else arg('route_point0_x'))"/>
    <arg name="point0_y" value="$(eval arg('goal4_y') if int(arg('point_num')) == 1 else arg('route_point0_y'))"/>
    <arg name="point0_z" value="$(eval arg('goal4_z') if int(arg('point_num')) == 1 else arg('route_point0_z'))"/>
    <arg name="point1_x" value="$(eval arg('goal4_x') if int(arg('point_num')) == 2 else arg('route_point1_x'))"/>
    <arg name="point1_y" value="$(eval arg('goal4_y') if int(arg('point_num')) == 2 else arg('route_point1_y'))"/>
    <arg name="point1_z" value="$(eval arg('goal4_z') if int(arg('point_num')) == 2 else arg('route_point1_z'))"/>
    <arg name="point2_x" value="$(eval arg('goal4_x') if int(arg('point_num')) == 3 else arg('route_point2_x'))"/>
    <arg name="point2_y" value="$(eval arg('goal4_y') if int(arg('point_num')) == 3 else arg('route_point2_y'))"/>
    <arg name="point2_z" value="$(eval arg('goal4_z') if int(arg('point_num')) == 3 else arg('route_point2_z'))"/>
    <arg name="point3_x" value="$(eval arg('goal4_x') if int(arg('point_num')) == 4 else arg('route_point3_x'))"/>
    <arg name="point3_y" value="$(eval arg('goal4_y') if int(arg('point_num')) == 4 else arg('route_point3_y'))"/>
    <arg name="point3_z" value="$(eval arg('goal4_z') if int(arg('point_num')) == 4 else arg('route_point3_z'))"/>
    <arg name="point4_x" value="$(arg goal4_x)"/>
    <arg name="point4_y" value="$(arg goal4_y)"/>
    <arg name="point4_z" value="$(arg goal4_z)"/>
    <arg name="relative_tracking_x" value="0.0"/>
    <arg name="relative_tracking_y" value="0.0"/>
    <arg name="relative_tracking_z" value="0.0"/>
    <arg name="swarm_clearance" value="$(arg swarm_clearance)"/>
    <arg name="tracking_error_replan_threshold" value="$(arg tracking_error_replan_threshold)"/>
    <arg name="tracking_velocity_error_replan_threshold" value="$(arg tracking_velocity_error_replan_threshold)"/>
  </include>

  <node pkg="ego_planner" name="drone_4_traj_server" type="traj_server" output="screen" launch-prefix="$(find multi_uav_formation)/scripts/ego_with_opencv.sh" if="$(eval int(arg('drone_count')) > 4)">
    <env name="LD_LIBRARY_PATH" value="/usr/local/lib:$(env LD_LIBRARY_PATH)"/>
    <remap from="/position_cmd" to="/drone_4_planning/pos_cmd"/>
    <remap from="~planning/trajectory" to="/drone_4_planning/trajectory"/>
    <param name="traj_server/time_forward" value="$(arg traj_time_forward)" type="double"/>
  </node>
</launch>
