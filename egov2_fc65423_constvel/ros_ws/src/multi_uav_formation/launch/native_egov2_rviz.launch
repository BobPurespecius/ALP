    </include>

    <!-- 本轮修复（RViz 只能是观察器）：RViz 退出/崩溃绝不能拖死仿真核心。
         required="true" 会让 rviz 一死就触发 roslaunch 整体 shutdown，
         表现为"目标和无人机瞬间全部静止"。仿真核心（planner / traj_server /
         target coordinator / rosmaster）的生命周期必须与 RViz UI 解耦。 -->
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" required="false"
          args="-d $(env NATIVE_EGOV2_EXPERIMENT_DIR)/ros_ws/src/multi_uav_formation/config/native_egov2.rviz"/>
    <param name="/drone_0_ego_planner_node/optimization/observation_radius_band" value="$(arg observation_radius_band)"/>
