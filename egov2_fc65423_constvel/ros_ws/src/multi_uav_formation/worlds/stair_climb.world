<?xml version="1.0"?>
<sdf version="1.6">
  <world name="stair_climb">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver><type>quick</type><iters>10</iters><sor>1.3</sor></solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <model name="stair_climb_obstacle_0">
      <static>true</static>
      <pose>-4.900 -2.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.380</radius><length>2.000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.380</radius><length>2.000</length></cylinder></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="stair_climb_obstacle_1">
      <static>true</static>
      <pose>5.300 2.000 1.000 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.420</radius><length>2.000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.420</radius><length>2.000</length></cylinder></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="stair_step_0">
      <static>true</static>
      <pose>-3.800 0.000 0.250 0 0 0.000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.300 3.400 0.500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.300 3.400 0.500</size></box></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="stair_step_1">
      <static>true</static>
      <pose>-1.400 0.000 0.575 0 0 0.000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.500 3.400 1.150</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.500 3.400 1.150</size></box></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="stair_step_2">
      <static>true</static>
      <pose>1.100 0.000 0.875 0 0 0.000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.500 3.400 1.750</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.500 3.400 1.750</size></box></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="upper_landing">
      <static>true</static>
      <pose>4.200 0.000 1.250 0 0 0.000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.700 3.400 2.500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.700 3.400 2.500</size></box></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="stair_side_wall_lower">
      <static>true</static>
      <pose>0.200 -2.150 0.850 0 0 0.000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>9.600 0.220 1.700</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.600 0.220 1.700</size></box></geometry>
          <material><ambient>0 0.8 0 0.85</ambient><diffuse>0 0.8 0 0.85</diffuse></material>
        </visual>
