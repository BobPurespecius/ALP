<?xml version="1.0"?>
<launch>
  <arg name="config" default="$(find target_tracking)/config/rao_2025_protocol.yaml"/>
  <arg name="profile" default="simulation"/>
  <arg name="manifest_path" default="/tmp/rao_2025_manifest.json"/>

  <group ns="rao_2025">
    <node pkg="target_tracking" type="rao_2025_protocol.py" name="protocol"
          args="--config $(arg config) --profile $(arg profile) --manifest $(arg manifest_path)"
          output="screen" required="true"/>
  </group>
</launch>
