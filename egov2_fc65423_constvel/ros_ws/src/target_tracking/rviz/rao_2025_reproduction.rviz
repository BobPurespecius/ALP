Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz/Grid
      Color: 90; 90; 90
      Enabled: true
      Name: Ground
      Plane: XY
      Plane Cell Count: 65
      Reference Frame: world
      Value: 0.5
    - Alpha: 1
      Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /rao_2025/markers
      Name: Scene and visibility
    - Alpha: 1
      Class: rviz/Path
      Color: 255; 40; 40
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: True target path
      Topic: /rao_2025/target_path
    - Alpha: 1
      Class: rviz/Path
      Color: 40; 160; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: Shared target path
      Topic: /rao_2025/target_shared_path
    - Alpha: 1
      Class: rviz/Path
      Color: 40; 220; 100
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: UAV 1 path
      Topic: /rao_2025/uav1/path
    - Alpha: 1
      Class: rviz/Path
      Color: 255; 180; 30
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: UAV 2 path
      Topic: /rao_2025/uav2/path
    - Alpha: 1
      Class: rviz/Path
      Color: 180; 80; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: UAV 3 path
      Topic: /rao_2025/uav3/path
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Top Down
      Scale: 45
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
